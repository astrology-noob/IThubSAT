@using IThubSAT.Data.Models
@using IThubSAT.Data.SurveyPages
@using IThubSAT.Data
@inject SurveyService SurveyService

<div class="survey-page">
    <p class="survey-page-name">@Page.PageTitle</p>
    @foreach(var item in Page.AllItems)
    {
        <div @onclick=@(async () => await SetGroup(item)) class="items-option">
            <div style="height: 15px; width: 15px; border: 1px solid black; border-radius: 15px;">@(item.Id == Page.SelectedItemId ? "x" : "")</div>
            <div>@item.Name</div>
        </div>
    }
</div>

@code {
    [Parameter] public ItemSelectionPage Page { get; set; } = new();

    // если просто снять выбор с варианта, метод тоже срабатывает, хотя не должен
    private async Task SetGroup(FilterItem item)
    {
        Page.SelectedItemId = item.Id;
        await Page.OnChooseItem.Invoke(item.Id);
    }
}

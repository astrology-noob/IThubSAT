@inject NavigationManager Navigation
@inject TopBarState TopBarState

<div class="top-bar">
    <div class="page-name">
        @if (TopBarState.HrefBack != string.Empty)
        {
            <a href="@(TopBarState.HrefBack)"><img src="icons/ArrowBack.svg" /></a>
        }
        <p>@TopBarState.PageTitle</p>
    </div>
    <div class="user-info-block">
        <div class="user-info">
            <p class="user-name">@Username</p>
            <a class="logout">Выйти</a>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Username { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        TopBarState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        TopBarState.OnChange -= StateHasChanged;
    }
}
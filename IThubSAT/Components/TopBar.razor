@inject NavigationManager Navigation
@inject AppNavigationState AppNavState

<div class="top-bar">
    <div class="page-name">
        @if (AppNavState.HrefBack != string.Empty)
        {
            <a href="@(AppNavState.HrefBack)"><img src="icons/ArrowBack.svg"/></a>
        }
        <p>@AppNavState.PageTitle</p>
    </div>
    <div class="user-info-block">
        <div class="user-info">
            <p class="user-name">@Username</p>
            <a class="logout">Выйти</a>
        </div>
    </div>
</div>

<style>
    .top-bar {
        height: 50px;
        width: calc(100% - 100px);
        margin: 30px 50px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .page-name {
        display: flex;
        gap: 10px;
        align-items: center;
    }

        .page-name p {
            font-size: 24px;
            font-weight: bold;
        }

        .page-name a {
            color: #000000;
            width: 40px;
            height: 40px;
            background-color: #FFFFFF;
            border: 1px solid #EBEEF5;
            border-radius: 10px;
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .page-name a:hover {
                color: #AB00EA;
            }

    .user-info-block {
        display: flex;
        gap: 10px;
    }

    .user-info {
        display: flex;
        flex-direction: column;
        align-items: end;
        justify-content: center;
    }

    .user-name {
        font-weight: bold;
        margin-bottom: 0px !important;
    }

    .logout {
        color: #898989;
    }
</style>

@code {
    [Parameter] public string Username { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        AppNavState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppNavState.OnChange -= StateHasChanged;
    }
}
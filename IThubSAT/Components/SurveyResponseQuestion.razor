@using IThubSAT.Data;
@using IThubSAT.Data.Models;
@using IThubSAT.Components.QuestionTypes;
@inject SurveyService SurveyService;

<div class="answer-survey-question">
    @(Question.QuestionType switch {
        QuestionType.Scale => @<ScaleQuestionAnswer Question=Question OnAnswerQuestion=SaveQuestionAnswer />,
        QuestionType.ShortText => @<ShortTextQuestionAnswer Question=Question OnAnswerQuestion=SaveQuestionAnswer />,
        QuestionType.LongText => @<LongTextQuestionAnswer Question=Question OnAnswerQuestion=SaveQuestionAnswer />,
        QuestionType.SingleChoice => @<ShortTextQuestionAnswer Question=Question OnAnswerQuestion=SaveQuestionAnswer />,
        QuestionType.MultipleChoice => @<ShortTextQuestionAnswer Question=Question OnAnswerQuestion=SaveQuestionAnswer />,
        _ => @<div>НЕТ ТАКОГО ТИПА ВОПРОСА</div>
    })
</div>

@code {
    [Parameter] public Question Question { get; set; } = null!;
    [Parameter] public Workload Workload { get; set; } = null!;
    [CascadingParameter] public SurveyEntry SurveyEntry { get; set; } = null!;
    private Answer Answer { get; set; } = new();

    public void SaveQuestionAnswer(string data)
    {
        if (Answer is null)
        {
            Answer = new() { QuestionId = Question.Id, WorkloadId = Workload.Id };
        }

        Answer.AnswerData = data;
        SurveyEntry.Answers.Add(Answer);
        
        Answer = new() { QuestionId = Question.Id, WorkloadId = Workload.Id };
    }

    protected override Task OnInitializedAsync()
    {
        // if (Question.IsRequired)
        // {
        Answer = new() { QuestionId = Question.Id, WorkloadId = Workload.Id };
        // }

        return base.OnInitializedAsync();
    }
}
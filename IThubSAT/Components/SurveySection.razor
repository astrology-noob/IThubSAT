@*Блок секции опроса во время прохождения опроса*@
@*Переименовать с Section на page?*@

<div class="cur-section-wrapper">
    <p class="section-name">@SectionTitle</p>
    @ChildContent
</div>

@code {
    [Parameter] public string SectionTitle { get; set; } = string.Empty;
    [Parameter] public RenderFragment ChildContent { get; set; } = null!;
}

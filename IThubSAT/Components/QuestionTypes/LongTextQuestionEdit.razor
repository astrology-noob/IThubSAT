@using IThubSAT.Data.Models;
@using IThubSAT.Data.Models.QuestionTypes;
@using Newtonsoft.Json;

<div class="text-input-edit">
    <textarea @bind=@longTextQuestion!.Example placeholder="Пример очень очень длинного ответа" />
</div>

<div class="buttons">
    <button class="delete-question-button" @onclick=DeleteQuestion>Удалить</button>
    <button class="save-question-button" @onclick=SaveQuestionInfo>Сохранить</button>
</div>

@code {
    [Parameter] public Question Question { get; set; } = null!;
    [Parameter] public EventCallback OnSaveQuestion { get; set; }
    [Parameter] public EventCallback<Question> OnDeleteQuestion { get; set; }
    private LongTextQuestionType longTextQuestion = new();

    protected override void OnInitialized()
    {
        try
        {
            longTextQuestion = JsonConvert.DeserializeObject<LongTextQuestionType>(Question.QuestionTypeInfo) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
        base.OnInitialized();
    }

    private void SaveQuestionInfo()
    {
        // сначала валидация
        Question.QuestionTypeInfo = JsonConvert.SerializeObject(longTextQuestion);
        OnSaveQuestion.InvokeAsync();
    }

    private void DeleteQuestion()
    {
        OnDeleteQuestion.InvokeAsync(Question);
    }
}

@using IThubSAT.Data.Models;
@using IThubSAT.Data.Models.QuestionTypes;
@using Newtonsoft.Json;

<p class="question-title">
    <span class="question-text">@(Question.Text)</span>
    @if (Question.IsRequired)
    {
        <span class="required-mark-span">*</span>
    }
</p>

<div class="short-text-question">
    <input type="text" @bind-value=Answer @oninput=SaveAnswer placeholder="@shortTextQuestion.Example" />
</div>

@code {
    [Parameter] public Question Question { get; set; } = null!;
    [Parameter] public EventCallback<string> OnAnswerQuestion { get; set; }
    
    private ShortTextQuestionType shortTextQuestion = new();

    protected override void OnInitialized()
    {
        try
        {
            shortTextQuestion = JsonConvert.DeserializeObject<ShortTextQuestionType>(Question.QuestionTypeInfo) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
        base.OnInitialized();
    }

    private string Answer = string.Empty;

    private void SaveAnswer()
    {
        OnAnswerQuestion.InvokeAsync(Answer);
    }
}
@using IThubSAT.Data.Models
@using IThubSAT.Data
@inject SurveyService SurveyService

<div class="survey-information">
    @*показывать кнопук только если появились изменения*@
    <button class="add-fullwidth-button" @onclick=SaveSurvey>Сохранить изменения</button>

    <div class="survey-information-block">
        <input class="underlined-input" style="width: 100%;" placeholder="Вступление" @bind-value=@Survey.IntroductionText />
    </div>

    <div class="chapters">
        @foreach(var chapter in Survey.Chapters)
        {
            <SurveyChapterInfo Chapter=chapter />
        }
    </div>

    <div class="survey-information-block">
        <input class="underlined-input" style="width: 100%;" placeholder="Заключение" @bind-value=@Survey.ConclusionText />
    </div>
</div>

@code {
    [Parameter] public Survey Survey { get; set; } = null!;

    private async Task SaveSurvey()
    {
        await SurveyService.SaveChanges();
    }
}
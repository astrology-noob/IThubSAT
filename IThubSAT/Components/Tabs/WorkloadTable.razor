@using IThubSAT.Data.Models
@using IThubSAT.Data
@using IThubSAT.Components
@inject SurveyService SurveyService

@* не забыть фильтровать сами наборы данных - или оставить на 2 версию? *@
<div class="tool-bar">
    <a class="primary-button" href="/surveys/@(Survey.Id)/import">Импорт</a>
    <button class="primary-button">Экспорт</button>
</div>

<div class="table-wrapper">
    <div class="table-row table-header">
        <div><Dropdown Placeholder="Кафедра" Items=Faculties OnChoose=UpdateData TabIndex=0 /></div>
        <div><Dropdown Placeholder="Курс" Items=StudyYears OnChoose=UpdateData TabIndex=1 /></div>
        <div><Dropdown Placeholder="Группа" Items=Groups OnChoose=UpdateData TabIndex=2 /></div>
        <div><Dropdown Placeholder="Подгруппа" Items=EnglishGroups OnChoose=UpdateData TabIndex=3 /></div>
        <div><Dropdown Placeholder="Спортклуб" Items=SportClubs OnChoose=UpdateData TabIndex=4 /></div>
        <div><Dropdown Placeholder="Дисциплина" Items=Disciplines OnChoose=UpdateData TabIndex=5 /></div>
        <div><Dropdown Placeholder="Преподаватель" Items=Teachers OnChoose=UpdateData TabIndex=6 /></div>
        <div>Часы в неделю</div>
        <div>Часы всего</div>
    </div>

    <div class="add-fullwidth-button" @onclick=AddWorkload>Добавить нагрузку +</div>
    
    <div class="table-content @(FilteredWorkloads.Count > 0 ? "table-scrollable" : string.Empty)">
        @if (FilteredWorkloads.Count() > 0) 
        {
            @foreach (var workloadRow in FilteredWorkloads) 
            {
                <WorkloadRow Workload=workloadRow />
            }
        }
        else 
        {
            <div class="table-row">Пока нет вообще никакой нагрузки</div>
        }
    </div>

</div>

@code {
    [Parameter] public Survey Survey { get; set; } = null!;

    private SearchModel _searchModel { get; set; } = new();

    [Parameter] public List<Workload> Workloads { get; set; } = new();
    public List<Workload> FilteredWorkloads { get; set; } = new();

    // Dropdown lists for filter options
    // обновлять списки фильтров при изменении строки
    // если вручную добавился элемент - похуй, он пустой всё равно
    // если был массовый импорт, то само подтягивается (потому что всё равно страница обновляется)
    #region filters
    public List<FilterItem> Faculties { get; set; } = new();
    public List<FilterItem> Groups { get; set; } = new();
    public List<FilterItem> EnglishGroups { get; set; } = new();
    public List<FilterItem> SportClubs { get; set; } = new();
    public List<FilterItem> Teachers { get; set; } = new();
    public List<FilterItem> Disciplines { get; set; } = new();
    public List<FilterItem> StudyYears { get; set; } = new();

    public List<FilterItem> FilteredFaculties { get; set; } = new();
    public List<FilterItem> FilteredGroups { get; set; } = new();
    public List<FilterItem> FilteredEnglishGroups { get; set; } = new();
    public List<FilterItem> FilteredSportClubs { get; set; } = new();
    public List<FilterItem> FilteredTeachers { get; set; } = new();
    public List<FilterItem> FilteredDisciplines { get; set; } = new();
    public List<FilterItem> FilteredStudyYears { get; set; } = new();
    #endregion

    // Pagination properties - не уверена насчёт того нужно это или нет, скорее всего да, для оптимизации, но хз
    public int CurrentPage { get; set; }
    public int TotalPages { get; set; }

    protected async override Task OnInitializedAsync()
    {
        FilteredWorkloads = Workloads;

        Groups = await SurveyService.GetGroupsFilterItems(Survey.Id) ?? new();
        Teachers = await SurveyService.GetTeachersFilterItems(Survey.Id) ?? new();
        Faculties = await SurveyService.GetFacultiesFilterItems(Survey.Id) ?? new();
        StudyYears = await SurveyService.GetStudyYearsFilterItems(Survey.Id) ?? new();
        // EnglishGroups = await SurveyService.GetEnglishGroupsFilterItems(Survey.Id) ?? new();
        // SportClubs = await SurveyService.GetSportClubsFilterItems(Survey.Id) ?? new();
        Disciplines = await SurveyService.GetDisciplinesFilterItems(Survey.Id) ?? new();

        FilteredGroups = Groups;
        FilteredTeachers = Teachers;
        FilteredFaculties = Faculties;
        FilteredStudyYears = StudyYears;
        FilteredEnglishGroups = EnglishGroups;
        FilteredSportClubs = SportClubs;
        FilteredDisciplines = Disciplines;

        await base.OnInitializedAsync();
    }

    public void UpdateData(FilterItem filterItem)
    {
        switch (filterItem.FilterType)
        {
            case FilterType.Discipline: 
                _searchModel.DisciplineId = filterItem.Id;
                break;
            case FilterType.Teacher:
                _searchModel.TeacherId = filterItem.Id;
                break;
            case FilterType.Faculty:
                _searchModel.FacultyId = filterItem.Id;
                break;
            case FilterType.EnglishGroup:
                _searchModel.EnglishGroupId = filterItem.Id;
                break;
            case FilterType.SportClub:
                _searchModel.SportClubId = filterItem.Id;
                break;
            case FilterType.Group:
                _searchModel.GroupId = filterItem.Id;
                break;
            case FilterType.StudyYear:
                _searchModel.StudyYear = filterItem.Id;
                break;
            default: throw new ArgumentOutOfRangeException();
        };

        if (_searchModel.IsEmpty())
            FilteredWorkloads = Workloads;
        else
        {
            var filteredIEnumerable = (IEnumerable<Workload>)Workloads;

            if (_searchModel.FacultyId != 0)
            {            
                filteredIEnumerable = filteredIEnumerable.Where(x => x.Group!.FacultyId == _searchModel.FacultyId);
            }
            if (_searchModel.GroupId != 0)
            {            
                filteredIEnumerable = filteredIEnumerable.Where(x => x.GroupId == _searchModel.GroupId);
            }
            if (_searchModel.EnglishGroupId != 0)
            {            
                filteredIEnumerable = filteredIEnumerable.Where(x => x.EnglishGroupId == _searchModel.EnglishGroupId);
            }
            if (_searchModel.EnglishLevelId != 0)
            {            
                filteredIEnumerable = filteredIEnumerable.Where(x => x.EnglishGroup!.EnglishLevelId == _searchModel.EnglishLevelId);
            }
            if (_searchModel.SportClubId != 0)
            {            
                filteredIEnumerable = filteredIEnumerable.Where(x => x.SportClubId == _searchModel.SportClubId);
            }
            if (_searchModel.TeacherId != 0)
            {            
                filteredIEnumerable = filteredIEnumerable.Where(x => x.TeacherId == _searchModel.TeacherId);
            }
            if (_searchModel.DisciplineId != 0)
            {            
                filteredIEnumerable = filteredIEnumerable.Where(x => x.DisciplineId == _searchModel.DisciplineId);
            }
            if (_searchModel.StudyYear != 0)
            {            
                filteredIEnumerable = filteredIEnumerable.Where(x => x.Group!.StudyYear == _searchModel.StudyYear);
            }

            FilteredWorkloads = filteredIEnumerable.ToList();
        }
    }

    public async Task AddWorkload()
    {
        // вызывать попап
        await SurveyService.SaveChanges();
    }

    private class SearchModel
    {
        public int FacultyId;
        public int GroupId;
        public int EnglishGroupId;
        public int EnglishLevelId;
        public int SportClubId;
        public int TeacherId;
        public int DisciplineId;
        public int StudyYear;

        public bool IsEmpty() => FacultyId + GroupId + EnglishGroupId + EnglishLevelId + SportClubId + TeacherId + DisciplineId + StudyYear == 0;
    }
}
@using IThubSAT.Data.Models

<div class="sections">
    <div>Вступление</div>
    <p>@Survey.IntroductionText</p>

    @foreach(var section in Survey.Sections)
    {
        <SurveySectionInfo Section=section/>
    }

    <div>Заключение</div>
    <p>@Survey.ConclusionText</p>
</div>


@code {
    [Parameter] public Survey Survey { get; set; } = null!; 
}
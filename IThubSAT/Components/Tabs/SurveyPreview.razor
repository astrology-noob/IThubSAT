@using IThubSAT.Data.Models;
@using IThubSAT.Data;

@if (PreviewData.Count > 0)
{
    <div class="survey-preview">
        @foreach (var faculty in PreviewData.Keys)
        {
            <FacultyPreview Data=PreviewData[faculty] Faculty=faculty />
        }
    </div>
}

@code {
    [Parameter] public List<Workload> Workloads { get; set; } = new();

    private Dictionary<Faculty, Dictionary<Group, List<DisciplinePreviewData>>> PreviewData = new();

    protected override void OnInitialized()
    {
        List<Faculty> faculties = Workloads.Select(x => x.Group!.Faculty).Distinct().ToList();
        List<DisciplinePreviewData> disciplinesAndTeachers;
        List<Group> groups;
        Dictionary<Group, List<DisciplinePreviewData>> groupData;

        foreach(var faculty in faculties)
        {
            groupData = new();
            groups = Workloads.Where(x => x.Group!.Faculty == faculty).Select(x => x.Group!).Distinct().ToList();

            foreach (var group in groups)
            {
                disciplinesAndTeachers = Workloads
                                            .Where(x => x.Group! == group)
                                            .Select(x => new DisciplinePreviewData { 
                                                Name = x.Discipline.Name, 
                                                TeacherFullName = x.Teacher.FullName,
                                                Hours = x.WeeklyHours
                                            }).ToList();
                groupData.Add(group, disciplinesAndTeachers);
            }
            
            PreviewData.Add(faculty, groupData);
        }
    }

}
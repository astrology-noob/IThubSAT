@using IThubSAT.Data.Models;

@if (PreviewData.Count > 0)
{
    <div class="survey-preview">
        @foreach (var faculty in PreviewData.Keys)
        {
            <div class="faculty-preview">
                <div class="faculty-preview-headrer">@faculty.Name</div>
                <div class="preview-cards">
                    @foreach (var group in PreviewData[faculty].Keys)
                    {    
                        <div class="preview-card">
                            <div class="preview-header">
                                <p>@group.Name</p>
                            </div>
                            <div class="preview-content">
                                @foreach (var discipline in PreviewData[faculty][group])
                                {
                                    <div class="preview-item">@discipline.Name</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

<style>
    .survey-preview {
        width: 100%;
        height: 100%;
        overflow-y: scroll;
    }

    .faculty-preview {
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    .faculty-preview-header {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .preview-cards {
        display: flex;
        flex-wrap: wrap;
        gap: 30px;
        justify-content: space-between;
    }

    .preview-card {
        width: 150px;
        height: 200px;
        background-color: #fff;
        border-radius: 5px;
    }

    .preview-header {
        width: 100%;
        height: 30px;
        border-bottom: #EBEEF5 1px solid;
        display: flex;
        justify-content: center;
    }

    .preview-header p {
        font-weight: bold;
    }

    .preview-content {
        width: 100%;
        height: 170px;
        overflow-y: scroll;
    }

    .preview-item {
        width: 100%;
        min-height: 25px;
    }
</style>

@code {
    [Parameter] public List<Workload> Workloads { get; set; } = new();

    private Dictionary<Faculty, Dictionary<Group, List<Discipline>>> PreviewData = new();

    protected async override Task OnInitializedAsync()
    {
        List<Faculty> faculties = Workloads.Select(x => x.Group!.Faculty).Distinct().ToList();
        List<Discipline> disciplines;
        List<Group> groups;
        Dictionary<Group, List<Discipline>> groupData;

        foreach(var faculty in faculties)
        {
            groupData = new();
            groups = Workloads.Where(x => x.Group!.Faculty == faculty).Select(x => x.Group!).Distinct().ToList();
            
            foreach (var group in groups)
            {
                disciplines = Workloads.Where(x => x.Group! == group).Select(x => x.Discipline).ToList();
                groupData.Add(group, disciplines);
            }
            
            PreviewData.Add(faculty, groupData);
        }
    }

}
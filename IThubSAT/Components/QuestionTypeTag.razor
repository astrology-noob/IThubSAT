@using IThubSAT.Data.Models;

<div class="question-type-tag" style="background-color: @BackgroundColor">
    @(QuestionType switch
    {
        QuestionType.Scale => "Шкала",
        _ => "Неизвестный тип"
    })
</div>

@code {
    [Parameter] public QuestionType QuestionType { get; set; }
    [Parameter] public string BackgroundColor { get; set; } = "#FFFFFF";
}

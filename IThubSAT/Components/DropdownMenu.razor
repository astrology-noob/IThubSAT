@using IThubSAT.Data;

<div class="dropdown-menu">
    @if(Options.Count == 0)
    {
        <span>Ничего нет</span>
    }
    @foreach(var option in Options) {
        <div @onclick=@(() => SetOption.InvokeAsync(option))>@option.Name</div>
    }
</div>

<style>
    .dropdown-menu {
        display: block;
        position: absolute;
        margin-top: 40px;
        height: 200px;
        width: 200px;
        overflow: scroll;
    }
</style>

@code {
    [Parameter] public List<FilterItem> Options { get; set; } = new();
    [Parameter] public EventCallback<FilterItem> SetOption { get; set; }
}
@using IThubSAT.Data;
@using IThubSAT.Data.Models;
@using IThubSAT.Data.SurveyPages;
@using IThubSAT.Components.SurveyPages;

<div class="answer-survey-content">

    @if(Pages is not null && Pages.Count > 0)
    {        
        @(Pages[_currentPageIndex] switch 
        {
            IntroPage p => (@<IntroPageComponent Page=p />),
            ItemSelectionPage g => (@<ItemSelectionPageComponent Page=g />),
            QuestionsPage q => (@<QuestionsPageComponent Page=q />),
            _ => (@<div>А</div>)
        })

        <div class="bottom-navigation">
            <button @onclick=GoBack>Назад</button>
            <button @onclick=GoForward>Вперёд</button>
        </div>
    }
</div>

@code {
    [Parameter] public List<SurveyPage> Pages { get; set; } = new();
    [Parameter] public EventCallback OnChangePage { get; set; }

    private int _currentPageIndex;

    private void GoForward()
    {
        int newPageIndex = _currentPageIndex + 1;

        if (newPageIndex >= Pages.Count) return;
        else
        {
            _currentPageIndex++;
        }

        // сохранять данные по ответам в бд
        OnChangePage.InvokeAsync();
    }

    private void GoBack()
    {
        int newPageIndex = _currentPageIndex - 1;

        if (newPageIndex < 0) return;
        else
        {
            _currentPageIndex--;
        }

        OnChangePage.InvokeAsync();
    }
}

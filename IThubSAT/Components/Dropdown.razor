@using IThubSAT.Data;

<div class="filter-area" tabindex=@TabIndex @onfocusin=@(() => showDropdown = true) @onfocusout="@(() => showDropdown = false)">
    <div class="filter">
        @if (ChosenOption.Id == 0)
        {
            <span>@Placeholder</span>
        }
        else
        {
            // сохранение на enter во 2 версии*@
            // <input @bind-value=searchText @oninput=SearchItems />

            <span>@ChosenOption.Name</span>
            <span @onclick=ClearChoice>x</span>
        }
    </div>

    @if (showDropdown)
    {
        // если в отфильтрованных данных ничего нет, выводить кнопку "создать новый"
        // (создаю filteritem с именем и инвоукаю метод который создаст в род. элементе нужный элемент на основе типа этого filteritem)
        // нужен тогда метод на "создание нового" (хотя это в фильтре не должно работать, только в инпуте в таблице)
        <DropdownMenu Options="FilterItems" SetOption="SetOption" />
    }
</div>

<style>
    .filter-area {
        width: 300px;
    }

    .filter {
        background-color: #F7F9FC;
        border-radius: 10px;
        border: 1px solid #EBEEF5;
        padding-left: 10px;
        width: inherit;
        min-height: 35px;
        display: flex;
        justify-content: space-between;
    }

    .filter:focus {
        outline: 1px solid #AB00EA;
    }
</style>

@code {
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public List<FilterItem> FilterItems { get; set; } = new();
    [Parameter] public EventCallback<FilterItem> OnChoose { get; set; } = new();
    [Parameter] public int TabIndex { get; set; }

    public List<FilterItem> FilteredFilterItems { get; set; } = new();
    private string searchText = string.Empty;
    public FilterItem ChosenOption { get; set; } = new();
    private bool showDropdown;

    protected override void OnInitialized()
    {
        FilteredFilterItems = FilterItems;
    }

    public void SetOption(FilterItem chosenItem)
    {
        ChosenOption = chosenItem;
        OnChoose.InvokeAsync(chosenItem);
        StateHasChanged();
    }

    public void ClearChoice()
    {
        ChosenOption = new() { FilterType = FilterItems[0].FilterType };
        OnChoose.InvokeAsync(ChosenOption);
    }

    private void SearchItems()
    {
        FilteredFilterItems = FilterItems.Where(x => x.Name.Contains(searchText)).ToList();
        StateHasChanged();
    }
}
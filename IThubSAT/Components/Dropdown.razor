@using IThubSAT.Data;

<div class="filter-area" tabindex=@TabIndex @onfocusin=@(() => showDropdown = true) @onfocusout="@(() => showDropdown = false)">
    <div class="filter">
        @if (ChosenOption.Id == 0)
        {
            <span>@Placeholder</span>
            <span>ջ</span>
        }
        else
        {
            <span>@ChosenOption.Name</span>
            <span @onclick=ClearChoice>x</span>
        }
    </div>

    @if (showDropdown)
    {
        <DropdownMenu Options="Items" SetOption="SetOption" />
    }
</div>

@code {
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public List<FilterItem> Items { get; set; } = new();
    [Parameter] public EventCallback<FilterItem> OnChoose { get; set; } = new();
    [Parameter] public int TabIndex { get; set; }

    public List<FilterItem> FilteredItems { get; set; } = new();
    private string searchText = string.Empty;
    public FilterItem ChosenOption { get; set; } = new();
    private bool showDropdown;

    protected override void OnInitialized()
    {
        FilteredItems = Items;
    }

    public void SetOption(FilterItem chosenItem)
    {
        ChosenOption = chosenItem;
        OnChoose.InvokeAsync(chosenItem);
        StateHasChanged();
    }

    public void ClearChoice()
    {
        ChosenOption = new() { FilterType = Items[0].FilterType };
        OnChoose.InvokeAsync(ChosenOption);
    }

    private void SearchItems()
    {
        FilteredItems = Items.Where(x => x.Name.Contains(searchText)).ToList();
        StateHasChanged();
    }
}
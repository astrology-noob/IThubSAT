@using IThubSAT.Data.Models;
@*Блок секции опроса во время прохождения опроса*@

<div class="survey-page">
    <p class="survey-page-name">@Workloads[CurrentWorkload].Discipline.Name</p>
    @*
        внутри секции могут быть следующие наполнения:
        - выбор группы
        - ответы на вопросы
        - выбор преподавателя
        сделать просто отдельные компоненты походу
    *@
    @ChildContent
</div>

<style>
    .survey-page {
        box-sizing: border-box;
        width: 800px;
        max-height: 80vh;
        overflow-y: scroll;
        padding: 30px 25px;
        background-color: #FFFFFF;
        border: solid 1px #EBEEF5;
        border-radius: 10px;
        margin-bottom: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .survey-page-name {
        font-weight: bold;
        font-size: 24px;
        margin-bottom: 30px;
    }
</style>

@code {
    [Parameter] public string PageTitle { get; set; } = string.Empty;
    [Parameter] public RenderFragment ChildContent { get; set; } = null!;
    [Parameter] public EventCallback OnGoForward { get; set; }
    
    // если это выбор группы или преподавателя, я не принимаю эти параметры, что делать?
    [Parameter] public List<Question> Questions { get; set; } = null!;
    [Parameter] public List<Workload> Workloads { get; set; } = null!;
    [Parameter] public int CurrentWorkload { get; set; }
}

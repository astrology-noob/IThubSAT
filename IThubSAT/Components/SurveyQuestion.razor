@* Вопрос в просмотре и редактировании опроса *@
@using IThubSAT.Data.Models;
@using IThubSAT.Data;
@inject SurveyService SurveyService;
@using IThubSAT.Components.QuestionTypes;

<div class="question-block">
    <div class="question-header">
        <div class="question-type-tag-dropdown">
            <Dropdown Items=QuestionTypes OnChoose=SetQuestionType Placeholder="Тип вопроса" TabIndex="1" ChosenItem="QuestionTypes.First(x => x.Id == (int)Question.QuestionType)" />
        </div>
        <input class="underlined-input" @bind-value=@Question.Text />
    </div>

    <button @onclick=ToggleIsRequired style="background-color: @(Question.IsRequired ? "red" : "")">
        Обязательный вопрос
    </button>
    @*TODO: добавить кнопку удаления и кнопки перемещения вопросов местами*@

    @(Question.QuestionType switch {
        QuestionType.Scale => @<ScaleQuestionEdit Question=Question OnSaveQuestion=SaveQuestion OnDeleteQuestion=DeleteQuestion />,
        QuestionType.ShortText => @<ShortTextQuestionEdit Question=Question OnSaveQuestion=SaveQuestion OnDeleteQuestion=DeleteQuestion />,
        QuestionType.LongText => @<LongTextQuestionEdit Question=Question OnSaveQuestion=SaveQuestion OnDeleteQuestion=DeleteQuestion />,
        _ => @<div>НЕТ ТАКОГО ТИПА ВОПРОСА</div>
    })
</div>

@code {
    // при рендере конкретного вопроса десериализовывать модельку из строки
    // добавить метод который будет вызываться на сохранение данных вопроса полученного из дочернего элемента (который содержит конкретную инфу по вопросу)
    // в методе модельку с доп. данными сериализовывать в строку и сохранять в нужное поле
    [Parameter] public Question Question { get; set; } = null!;

    private List<FilterItem> QuestionTypes = new()
    {
        new() { Id = 1, Name = "Шкала", FilterType = FilterType.QuestionType },
        new() { Id = 2, Name = "Короткий текст", FilterType = FilterType.QuestionType },
        new() { Id = 3, Name = "Длинный текст", FilterType = FilterType.QuestionType },
    };

    private void SetQuestionType(FilterItem filterItem)
    {
        Question.QuestionType = (QuestionType)filterItem.Id;
        SurveyService.SaveChanges().GetAwaiter().OnCompleted(() => StateHasChanged());
    }

    public async Task SaveQuestion()
    {
        await SurveyService.SaveChanges();
    }

    public async Task DeleteQuestion(Question question)
    {
        await SurveyService.DeleteQuestionAsync(question);
        StateHasChanged();
    }

    private void ToggleIsRequired() => Question.IsRequired = !Question.IsRequired;
}

@*Блок секции опроса для просмотра и изменения*@
@using IThubSAT.Data.Models
@using IThubSAT.Data;
@inject SurveyService SurveyService;

<div class="chapter survey-information-block">
    <div class="chapter-header">
        <div class="chapter-info">
            <DisciplineTypeTag DisciplineType=Chapter.DisciplineType />
            @*нельзя чтобы был пустой*@
            <input placeholder="Название главы" type="text" class="underlined-input chapter-name" @bind=@Chapter.Name />
        </div>

        <button class="icon-button"
                @onclick=ToggleChapterVisibility>
            <img style="@(IsFullyVisible ? "transform: rotateX(180deg)" : "")" src="icons/Collapse.svg" />
        </button>
    </div>

    @if(IsFullyVisible)
    {
        <div class="chapter-content">
            <div class="chapter-questions">
                @if (Chapter.Questions != null && Chapter.Questions.Count > 0)
                {
                    @foreach (var question in Chapter.Questions!) {
                        <SurveyQuestion Question=question />
                    }
                }
                else
                {
                    <p>Если в разделе нет вопросов, он не будет отображаться студентам</p>
                }
            </div>

            <button class="add-fullwidth-button" @onclick=AddQuestion>Добавить вопрос +</button>
        </div>
    }
</div>

@code {
    [Parameter] public Chapter Chapter { get; set; } = null!;
    private bool IsFullyVisible = true;

    private void AddQuestion()
    {
        Question newQuestion = new() { Text = "Текст по умолчанию", QuestionType = QuestionType.Scale };
        Chapter.Questions.Add(newQuestion);
        SurveyService.SaveChanges().GetAwaiter().OnCompleted(() => StateHasChanged());
    }

    private void ToggleChapterVisibility() {
        IsFullyVisible = !IsFullyVisible;
        StateHasChanged();
    }
}
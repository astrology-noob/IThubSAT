@page "/"
@using IThubSAT.Components
@using IThubSAT.Data
@using IThubSAT.Data.Models
@using System.Linq
@inject SurveyService SurveyService
@inject NavigationManager Navigation
@inject TopBarState TopBarState
@layout AdminLayout

<TabsControl>
    <TabPage Text="Активные">
        <SurveyList Surveys="_surveys.Where(s => s.IsOpen == true).ToList()" AddSurvey="AddSurvey" />
    </TabPage>
    <TabPage Text="Остановленные">
        <SurveyList Surveys="_surveys.Where(s => (s.IsOpen == false) & (s.EndDate != string.Empty)).ToList()" AddSurvey="AddSurvey" />
    </TabPage>
    <TabPage Text="Черновики">
        <SurveyList Surveys="_surveys.Where(s => (s.IsOpen == false) & (s.StartDate != string.Empty)).ToList()" AddSurvey="AddSurvey" />
    </TabPage>
    <TabPage Text="Все">
        <SurveyList Surveys="_surveys" />
    </TabPage>
</TabsControl>

@*@ref позволяет ссылаться на один и тот же инстанс, а не создавать каждый раз новые модалки??? *@ 
<AddSurveyPopUp @ref="AddSurveyPopUp" CloseEventCallback=AddSurvey_OnDialogClose></AddSurveyPopUp>

@code {
    protected List<Survey> _surveys = new List<Survey>();
    private string text = string.Empty;

    public AddSurveyPopUp AddSurveyPopUp { get; set; } = null!;

    protected async override Task OnInitializedAsync()
    {
        _surveys = await SurveyService.GetSurveys();
        TopBarState.SetTopBarData("Главная");
        base.OnInitialized();
    }

    private void AddSurvey()
    {
        AddSurveyPopUp.Show();
    }

    public void AddSurvey_OnDialogClose(int id)
    {
        // ничё не делает...
        Navigation.NavigateTo($"/surveys/{id}");
        StateHasChanged();
    }
}
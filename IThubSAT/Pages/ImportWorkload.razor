@page "/surveys/{surveyId:int}/import"
@using IThubSAT.Data.Models
@using IThubSAT.Data
@using OfficeOpenXml;
@using System.ComponentModel.DataAnnotations
@inject SurveyService SurveyService
@inject TopBarState TopBarState
@layout AdminLayout


<div class="workload-import">
    @*Может менять заголовок в зависимости от действия*@
    <h4>Выберите файл Excel (.xslx)</h4>
    <p>
        Загружаемые данные должны соответствовать шаблону
    </p>
    <p><a class="underlined-link" href="Workload/DownloadTemplate">Скачать шаблон</a></p>

    <InputFile OnChange="LoadFiles" accept=".xlsx" />
    <button class="primary-button" @onclick=@ImportData>
        Импортировать
    </button>
</div>

@if (!string.IsNullOrEmpty(_importMessage))
{
    <div>
        @_importMessage
    </div>
}

<div class="import-summary" style="width: 500px">
    @foreach (var error in _importErrors)
    {
        <div style="height: 50px; display: flex; align-items: center; justify-content: space-between">
            <div style="font-size: large; color: red">@error.RowNumber</div>
            <div>@error.Message</div>
        </div>
    }
</div>

@code {
    [Parameter] public int surveyId { get; set; }
    // The uploaded Excel file (.xlsx)
    public IBrowserFile? FileUpload { get; set; }
    // Message for overall import status
    private int _totalImportedRows;
    private string _importMessage = string.Empty;
    private List<ImportError> _importErrors = new();

    protected async override Task OnInitializedAsync()
    {
        TopBarState.SetTopBarData("Импорт нагрузки", $"/surveys/{surveyId}");

        await base.OnInitializedAsync();
    }

    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        FileUpload = e.File;

        if (FileUpload == null || FileUpload.Size == 0)
        {
            _importMessage = "Please select an Excel file to upload.";
            return;
        }
    }

    private async Task ImportData()
    {
        MemoryStream ms = new MemoryStream();
        await FileUpload.OpenReadStream().CopyToAsync(ms);
        ExcelPackage.License.SetNonCommercialPersonal("IThub");

        using (var package = new ExcelPackage(ms))
        {
            var worksheet = package.Workbook.Worksheets.FirstOrDefault();
            if (worksheet == null)
            {
                _importMessage = "No worksheet found in Excel file.";
                return;
            }
            int rowCount = worksheet.Dimension.Rows;
            // Loop from row 2 (assuming row 1 contains headers)
            for (int row = 3; row <= rowCount; row++)
            {
                string facultyName = worksheet.Cells[row, 1].Text.Trim();
                string studyYearText = worksheet.Cells[row, 2].Text.Trim();
                string groupName = worksheet.Cells[row, 3].Text.Trim();
                string englishGroupName = worksheet.Cells[row, 4].Text.Trim();
                string sportClubName = worksheet.Cells[row, 5].Text.Trim();
                string disciplineName = worksheet.Cells[row, 6].Text.Trim();
                string teacherName = worksheet.Cells[row, 7].Text.Trim();
                string hoursInSemesterText = worksheet.Cells[row, 8].Text.Trim();
                string hoursInWeekText = worksheet.Cells[row, 9].Text.Trim();
                string englishLevelName = worksheet.Cells[row, 10].Text.Trim();
                string comment = worksheet.Cells[row, 11].Text.Trim();
                string studentsInGroupText = worksheet.Cells[row, 12].Text.Trim();

                // Skip rows with an empty discipline name.
                if (string.IsNullOrWhiteSpace(disciplineName) || string.IsNullOrWhiteSpace(teacherName))
                    continue;

                var importError = new ImportError() { RowNumber = row };

                // наверное даже все эти вары можно заранее задать ещё до перечисления, только их нужно будет обнулять перед каждой строкой
                // ошибки нужно выводить в нормальном виде для пользователя
                try
                {
                    int studyYear = studyYearText == string.Empty ? 0 : int.Parse(studyYearText);
                    int hoursInSemester = hoursInSemesterText == string.Empty ? 0 : int.Parse(hoursInSemesterText);
                    int hoursInWeek = hoursInWeekText == string.Empty ? 0 : int.Parse(hoursInWeekText);
                    int studentsInGroup = studentsInGroupText == string.Empty ? 0 : int.Parse(studentsInGroupText);

                    Faculty? faculty = null;
                    if (!string.IsNullOrWhiteSpace(facultyName))
                    {
                        faculty = await SurveyService.GetFacultyByName(facultyName);
                        if (faculty == null)
                        {
                            faculty = new() { Name = facultyName };
                            await SurveyService.AddNewFaculty(faculty);
                        }
                    }

                    Group? group = null;
                    if (!string.IsNullOrWhiteSpace(groupName))
                    {
                        group = await SurveyService.GetGroupByName(groupName);
                        if (group == null)
                        {
                            group = new() { Faculty = faculty, Name = groupName, StudyYear = studyYear, StudentsInGroup = studentsInGroup };
                            await SurveyService.AddNewGroup(group);
                            await SurveyService.SaveChanges();
                        }
                    }

                    var disciplineType = DisciplineType.General;

                    EnglishLevel? englishLevel = null;
                    EnglishGroup? englishGroup = null;

                    if (!string.IsNullOrWhiteSpace(englishLevelName) && !string.IsNullOrWhiteSpace(englishGroupName))
                    {
                        disciplineType = DisciplineType.English;

                        englishLevel = await SurveyService.GetEnglishLevelByName(englishLevelName);
                        if (englishLevel == null)
                        {
                            englishLevel = new() { Name = englishLevelName };
                            await SurveyService.AddNewEnglishLevel(englishLevel);
                            await SurveyService.SaveChanges();
                        }

                        englishGroup = await SurveyService.GetEnglishGroupByName(englishGroupName);
                        if (englishGroup == null)
                        {
                            englishGroup = new() { Name = englishGroupName, EnglishLevel = englishLevel };
                            await SurveyService.AddNewEnglishGroup(englishGroup);
                            await SurveyService.SaveChanges();
                        }
                    }

                    SportClub? sportClub = null;

                    if (!string.IsNullOrWhiteSpace(sportClubName))
                    {
                        sportClub = await SurveyService.GetSportClubByName(sportClubName);
                        if (sportClub == null)
                        {
                            sportClub = new() { Name = sportClubName };
                            await SurveyService.AddNewSportClub(sportClub);
                            await SurveyService.SaveChanges();

                            if (disciplineType == DisciplineType.English)
                            {
                                // если до этого дисциплину обозначили как английский - ошибка, шаблон заполнен неправильно
                                AddImportError(importError, "Дисциплина одновременно является иностранным языком и спортклубом");
                                continue;
                            }

                            disciplineType = DisciplineType.Sport;
                        }
                    }

                    // проблема походу в том что дисциплин пока нет в бд и поэтому он не находит
                    // а ещё возможно не находит потому что это всё асинхронные методы и они не дожидаются друг друга
                    var discipline = await SurveyService.GetDisciplineByName(disciplineName);
                    if (discipline == null)
                    {
                        // получать чекбокс, является ли факультативом
                        discipline = new() { Name = disciplineName, IsOptional = false, DisciplineType = disciplineType };
                        await SurveyService.AddNewDiscipline(discipline);
                        await SurveyService.SaveChanges();
                    }

                    var teacherFio = teacherName.Split(' ');

                    var teacher = await SurveyService.GetTeacherByFio(teacherFio);
                    if (teacher == null)
                    {
                        teacher = new() { LastName = teacherFio[0], FirstName = teacherFio[1], PaternalName = teacherFio[2] };
                        await SurveyService.AddNewTeacher(teacher);
                        await SurveyService.SaveChanges();
                    }

                    Workload? workload = disciplineType switch
                    {
                        DisciplineType.General => await SurveyService.GetSpecificWorkload(group!, discipline, teacher),
                        DisciplineType.English => await SurveyService.GetSpecificWorkload(englishGroup!, englishLevel!, discipline, teacher),
                        DisciplineType.Sport => await SurveyService.GetSpecificWorkload(sportClub!, discipline, teacher),
                        _ => throw new ArgumentOutOfRangeException(nameof(disciplineType), $"Not expected direction value: {disciplineType}"),
                    };

                    if (workload == null)
                    {
                        workload = new Workload
                        {
                            SurveyId = surveyId,
                            Group = group,
                            Discipline = discipline,
                            Teacher = teacher,
                            EnglishGroup = englishGroup,
                            SportClub = sportClub,
                            WeeklyHours = hoursInWeek,
                            TotalHours = hoursInSemester,
                            // ещё один столбец
                            TeacherIsCurrent = false,
                            Comment = comment
                        };
                        
                        if (!Validate(workload, importError)) { continue; }

                        await SurveyService.AddNewWorkload(workload);
                        await SurveyService.SaveChanges();
                    }
                    else
                    {
                        workload.SurveyId = surveyId;
                        workload.Group = group;
                        workload.Discipline = discipline;
                        workload.Teacher = teacher;
                        workload.EnglishGroup = englishGroup;
                        workload.SportClub = sportClub;
                        workload.WeeklyHours = hoursInWeek;
                        workload.TotalHours = hoursInSemester;
                        // ещё один столбец
                        workload.TeacherIsCurrent = false;
                        workload.Comment = comment;

                        if (!Validate(workload, importError)) { continue; }

                        SurveyService.UpdateWorkload(workload);
                    }

                    _totalImportedRows++;
                }
                catch (Exception ex)
                {
                    AddImportError(importError, $"Ошибка: {ex.Message}");
                }
            }
        }

        _importMessage = $"Import process completed. {_totalImportedRows} products processed successfully.";
        return;
    }

    private bool Validate(Workload workload, ImportError importError)
    {
        var validationContext = new ValidationContext(workload, null, null);
        var validationResults = new List<ValidationResult>();
        if (!Validator.TryValidateObject(workload, validationContext, validationResults, true))
        {
            AddImportError(importError, string.Join("; ", validationResults.Select(v => v.ErrorMessage)));
            return false;
        }
        return true;
    }

    private void AddImportError(ImportError importError, string errorMessage)
    {
        importError.Message = errorMessage;
        _importErrors.Add(importError);
    }

    private class ImportError
    {
        public int RowNumber;
        public string Message = string.Empty;
    }
}

@page "/surveys/{SurveyId:int}"
@using IThubSAT.Components
@using IThubSAT.Components.Tabs
@using IThubSAT.Data
@using IThubSAT.Data.Models
@inject SurveyService SurveyService
@inject TopBarState TopBarState
@layout AdminLayout

@*получать в параметрах #tab=название и автоматически делать эту вкладку активной *@

<div class="survey-actions-bar">
    @if (Survey.IsOpen)
    {
        <button class="primary-button" @onclick=GetSurveyResponseLink>Получить ссылку</button>
        <a class="secondary-button" href="/surveys/@(Survey.Id)/answers">Перейти к ответам</a>
        <button class="secondary-button" @onclick=StopSurvey>Остановить</button>
    }
    else
    {
        <button class="primary-button" @onclick=PublishSurvey>Опубликовать</button>
        <button class="secondary-button" @onclick=DeleteSurvey>Удалить</button>
    }
</div>

@if(!string.IsNullOrEmpty(Survey.Name))
{
    <TabsControl>
        <TabPage Text="Главы">
            <SurveyChapters Survey=Survey/>
        </TabPage>
        <TabPage Text="Нагрузка">
            <WorkloadTable Survey=Survey Workloads=Workloads />
        </TabPage>
        <TabPage Text="Предпросмотр">
            <SurveyPreview Workloads=Workloads />
        </TabPage>
    </TabsControl>
}
else {
    <div>Survey not found</div>
}

@code {
    [Parameter] public int SurveyId { get; set; }

    protected Survey Survey = new Survey();
    protected List<Workload> Workloads { get; set; } = new();


    protected async override Task OnInitializedAsync()
    {
        Survey = await SurveyService.GetSurveyByIdAsync(SurveyId) ?? Survey;
        Workloads = await SurveyService.GetWorkloadBySurveyId(Survey.Id);
        TopBarState.SetTopBarData(Survey.Name, "/");
        await base.OnInitializedAsync();
    }

    private async Task StopSurvey()
    {
        await SurveyService.StopSurvey(Survey);
        StateHasChanged();
    }

    private async Task PublishSurvey()
    {
        await SurveyService.PublishSurvey(Survey);
        StateHasChanged();
    }

    private void DeleteSurvey()
    {

    }

    private void GetSurveyResponseLink()
    {
        
    }
}
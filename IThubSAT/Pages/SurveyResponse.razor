@page "/surveys/{SurveyId:int}/answer"
@using IThubSAT.Components
@using IThubSAT.Components.SurveyPages;
@using IThubSAT.Data.Models
@using IThubSAT.Data.SurveyPages
@using IThubSAT.Data
@inject SurveyService SurveyService
@inject TopBarState TopBarState

@layout StudentLayout


@if (string.IsNullOrWhiteSpace(error))
{
    <CascadingValue Value=_surveyEntry>
        <SurveyPaginator Pages=surveyPages OnChangePage=StateHasChanged OnChangeGroup=GetWorkloadsByGroupId />
    </CascadingValue>
}
else
{
    <ResponseError ErrorText=@error />
}

@code {
    [Parameter] public int SurveyId { get; set; }
    private SurveyEntry _surveyEntry = new();
    private Survey? _survey;

    protected List<FilterItem> allGroups = new();
    // protected int selectedGroupId = -1;
    protected List<FilterItem> englishLevels = new();
    protected int selectedEnglishGroupId = -1;
    protected List<FilterItem> allSportClubs = new();
    protected int selectedSportClubId = -1;

    List<Question> generalQuestions;
    List<Question> englishQuestions;
    List<Question> sportQuestions;

    // короче какой вариант
    // можно по полученной нагрузке динамически вставлять страницы после страниц с выбором группы
    // но это чё-то капец наверное
    private List<SurveyPage> surveyPages = new();

    private string error = string.Empty;

    private List<Workload> _workloads = new();


    protected async override Task OnInitializedAsync()
    {
        _survey = await SurveyService.GetSurveyByIdAsync(SurveyId);

        if (_survey == null)
        {
            error = "Такого опроса не нашли :(";
            return;
        }

        if (!_survey.IsOpen)
        {
            error = "Мы сейчас не принимаем ответы на этот опрос :(";
            return;
        }

        TopBarState.SetTopBarData(_survey.Name);

        _surveyEntry.Survey = _survey!;

        allGroups = await SurveyService.GetGroupsFilterItems(_survey.Id) ?? allGroups;

        surveyPages = new() {
            new IntroPage() { IntroductionText = _survey.IntroductionText, PageTitle = "Введение" },
            new GroupSelectionPage() { allGroups = allGroups, PageTitle = "Выбери группу" }
        };

        generalQuestions = await SurveyService.GetQuestionsByChapterId(_survey.Chapters.First(x => x.DisciplineType == DisciplineType.General).Id);
        englishQuestions = await SurveyService.GetQuestionsByChapterId(_survey.Chapters.First(x => x.DisciplineType == DisciplineType.English).Id);
        sportQuestions = await SurveyService.GetQuestionsByChapterId(_survey.Chapters.First(x => x.DisciplineType == DisciplineType.Sport).Id);

        await base.OnInitializedAsync();
    }

    private async Task GetWorkloadsByGroupId(int selectedGroupId)
    {
        Console.WriteLine(selectedGroupId);
        // _currentChapter должен быть первым только, это метод только для получения нагрузки по группе (для обычных дисциплин, аааа блять, нет)
        _workloads = await SurveyService.GetWorkloadsBySurveyIdAndStudyGroupId(SurveyId, selectedGroupId);

        if (selectedGroupId != 0 && _workloads.Count == 0)
        {
            // это должно высвечиваться под дропдауном, чтобы у студента была возможность поменять выбор
            // + в таком случае должна блокироваться стрелочка вперёд
            error = "По вашей группе нет данных. Выберите другую группу или обратитесь к администратору";
            return;
        }

        var index = 2;


        foreach (var workload in _workloads.Where(x => x.Discipline.DisciplineType == DisciplineType.General).ToList())
        {
            surveyPages.Insert(index++, new QuestionsPage()
            {
                PageTitle = workload.Discipline.Name,
                Questions = generalQuestions
            });
        }

        // а ещё если workloads содержит английский и спорт
        if (englishQuestions.Count > 0) {
            surveyPages.Add(new QuestionsPage() { PageTitle = "Иностранный язык", Questions = englishQuestions });
        }

        if (sportQuestions.Count > 0)
        {
            surveyPages.Add(new QuestionsPage() { PageTitle = "Спортивные клубы", Questions = sportQuestions });
        }
    }
}